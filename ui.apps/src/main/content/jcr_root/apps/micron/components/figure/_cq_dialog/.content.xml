<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="DITA Figure"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <content
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <captionOverride
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                fieldLabel="Caption override"
                                fieldDescription="Leave empty to use the generated DITA caption."
                                name="./captionOverride"
                                useFixedInlineToolbar="{Boolean}true"/>
                            <descriptionOverride
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                fieldLabel="Notes override"
                                fieldDescription="Leave empty to use generated DITA notes."
                                name="./descriptionOverride"
                                useFixedInlineToolbar="{Boolean}true"/>
                            <fileReferenceOverride
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Image override"
                                fieldDescription="Leave empty to use the generated DITA image."
                                name="./fileReferenceOverride"
                                rootPath="/content/dam"
                                forceSelection="{Boolean}true"/>
                            <altOverride
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Alternative text override"
                                name="./altOverride"/>
                            <decorativeOverride
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                fieldDescription="Decorative images are ignored by assistive technologies."
                                text="Image is decorative"
                                name="./decorativeOverride"
                                value="{Boolean}true"
                                uncheckedValue="{Boolean}false"/>
                        </items>
                    </content>
                    <layout
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Layout"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <placementOverride
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Placement"
                                name="./placementOverride">
                                <items jcr:primaryType="nt:unstructured">
                                    <generated
                                        jcr:primaryType="nt:unstructured"
                                        text="Use generated value"
                                        value=""/>
                                    <inline
                                        jcr:primaryType="nt:unstructured"
                                        text="Inline"
                                        value="inline"/>
                                    <break
                                        jcr:primaryType="nt:unstructured"
                                        text="Block"
                                        value="break"/>
                                </items>
                            </placementOverride>
                            <orientationOverride
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Orientation"
                                name="./orientationOverride">
                                <items jcr:primaryType="nt:unstructured">
                                    <generated
                                        jcr:primaryType="nt:unstructured"
                                        text="Use generated value"
                                        value=""/>
                                    <landscape
                                        jcr:primaryType="nt:unstructured"
                                        text="Landscape"
                                        value="orient-land"/>
                                    <portrait
                                        jcr:primaryType="nt:unstructured"
                                        text="Portrait"
                                        value="orient-portrait"/>
                                </items>
                            </orientationOverride>
                            <hideCaption
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                text="Hide caption"
                                name="./hideCaption"
                                value="{Boolean}true"
                                uncheckedValue="{Boolean}false"/>
                            <hideDescription
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                text="Hide notes"
                                name="./hideDescription"
                                value="{Boolean}true"
                                uncheckedValue="{Boolean}false"/>
                        </items>
                    </layout>
                    <source
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Generated source"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <sourceId
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="DITA source ID"
                                name="./sourceId"
                                disabled="{Boolean}true"/>
                            <captionHtml
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                fieldLabel="Generated caption"
                                fieldDescription="Managed by AEM Guides. Use the Content tab to override."
                                name="./captionHtml"
                                useFixedInlineToolbar="{Boolean}true"
                                disabled="{Boolean}true"/>
                            <descriptionHtml
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                fieldLabel="Generated notes"
                                fieldDescription="Managed by AEM Guides. Use the Content tab to override."
                                name="./descriptionHtml"
                                useFixedInlineToolbar="{Boolean}true"
                                disabled="{Boolean}true"/>
                            <fileReference
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Generated image"
                                name="./fileReference"
                                rootPath="/content/dam"
                                disabled="{Boolean}true"/>
                            <alt
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Generated alternative text"
                                name="./alt"
                                disabled="{Boolean}true"/>
                            <placement
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Generated placement"
                                name="./placement"
                                disabled="{Boolean}true"/>
                            <outputClass
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Generated output class"
                                name="./outputClass"
                                disabled="{Boolean}true"/>
                        </items>
                    </source>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
