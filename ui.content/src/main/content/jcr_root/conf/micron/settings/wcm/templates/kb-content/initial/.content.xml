<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/micron/settings/wcm/templates/kb-content"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="micron/components/page"
        id="category-page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="core/wcm/components/container/v1/container">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container">
                <container_4321
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    layout="responsiveGrid">
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="$category.html$"
                        textIsRich="true"/>
                </container_4321>
                <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="page-with-search-in-header"
                    layout="responsiveGrid">
                    <container3
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="cp-root-container"
                        layout="responsiveGrid">
                        <container_482659403_
                            jcr:lastModifiedBy="admin"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/container/v1/container"
                            id="welcome-container">
                            <container
                                jcr:lastModifiedBy="admin"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/container/v1/container"
                                id="search-container">
                                <title
                                    jcr:lastModifiedBy="admin"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="How can we help?"
                                    sling:resourceType="core/wcm/components/title/v2/title"
                                    type="h1"/>
                                <searchbar
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="micron/components/searchbar"
                                    hideButton="true"
                                    resultpage="/content/micron/en/search"
                                    searchRoot="/content/micron/en/docs/product1"/>
                            </container>
                        </container_482659403_>
                        <container8
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/container/v1/container"
                            id="table-of-contents">
                            <text
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/text/v2/text"
                                text="Table of contents for Product 1"
                                textIsRich="true"/>
                            <cq:responsive jcr:primaryType="nt:unstructured">
                                <default
                                    jcr:primaryType="nt:unstructured"
                                    offset="0"
                                    width="3"/>
                                <phone
                                    jcr:primaryType="nt:unstructured"
                                    offset="0"
                                    width="12"/>
                            </cq:responsive>
                            <container0
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/container/v1/container"
                                id="table-of-contents-trigger"/>
                            <container238
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="micron/components/guidessidenavigation"/>
                        </container8>
                    </container3>
                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
