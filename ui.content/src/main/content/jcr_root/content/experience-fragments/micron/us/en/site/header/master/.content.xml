<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/micron/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="micron/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="micron/components/container"
            layout="simple">
            <customheader
                jcr:primaryType="nt:unstructured"
                sling:resourceType="micron/components/structure/customheader"
                linkText="LINK TEXT"
                logoAlt="Micron"
                logoLink="/content/micron/us/en.html"
                searchResultsPath="/content/micron/us/en/search.html"/>
        </root>
    </jcr:content>
</jcr:root>
