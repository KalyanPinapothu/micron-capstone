/0000 { /type "deny" /url "*" }
/0001 { /type "deny" /url "/bin/dita/*" }
/0002 { /type "deny" /url "/crx/*" }
/0003 { /type "deny" /url "/system/console/*" }
/0004 { /type "deny" /url "/etc/dita/profiles/*" }
